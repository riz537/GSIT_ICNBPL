{
  "name": "GSIT_ICNPBL",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap/cds": "^9",
    "@sap/xssec": "^4",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49",
    "@sap/dev-cap-tools": "^1.31.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-icnpblapp": "cds watch --open com.ui5.lly.icnpbl.icnpblapp/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy GSIT_ICNPBL --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "cds": {
    "requires": {
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "masterdata_edmx": {
        "kind": "odata-v2",
        "model": "srv/external/masterdata.edmx",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "S4HANA-ICNPB-POC",
          "path": "/sap/opu/odata/sap/ZSB_ICNPB_MASTERDATA"
        }
      },
      "bpa_dest": {
        "kind": "rest",
        "credentials": {
          "destination": "sap_process_automation_service"
        }
      },
      "email_iflow": {
        "kind": "rest",
        "credentials": {
          "destination": "SAC_Auditlog_cpi"
        }
      },
      "API_PURCHASEORDER_PROCESS_SRV_edmx": {
        "kind": "odata-v2",
        "model": "srv/external/API_PURCHASEORDER_PROCESS_SRV.edmx",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "S4HANA-ICNPB-POC",
          "path": "/sap/opu/odata/sap/ZAPI_PO_SRV"
        }
      },
      "ZI_PO_DOC_TRACKING_edmx": {
        "kind": "odata-v2",
        "model": "srv/external/ZI_PO_DOC_TRACKING.edmx",
        "csrf": true,
        "csrfInBatch": true,
        "credentials": {
          "destination": "S4HANA-ICNPB-POC",
          "path": "/sap/opu/odata/sap/ZI_PO_DOC_TRACKING"
        }
      }
    }
  }
}