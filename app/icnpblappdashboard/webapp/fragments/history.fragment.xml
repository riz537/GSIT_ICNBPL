<core:FragmentDefinition xmlns="sap.m"
	xmlns:c="sap.suite.ui.commons"
	xmlns:core="sap.ui.core">
	<Popover title="Sample popover" contentHeight="90%" contentWidth="38%">
		<List busyIndicatorDelay="0" items="{path:'approvalHistory',sorter:{path:'timestamp',descending:true}}" class="sapUiTinyMargin" width="auto">
			<StandardListItem title="{actor} on {timestamp}" description="{comments}" icon="{path:'action',formatter:'.f.formatIcon'}" iconInset="false"  info="{action}" infoState="{path:'action',formatter:'.f.formatColor'}" infoStateInverted="true" />
		</List>
	</Popover>
</core:FragmentDefinition>