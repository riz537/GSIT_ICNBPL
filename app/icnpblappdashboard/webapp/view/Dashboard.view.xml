<mvc:View controllerName="com.ui5.lly.icnpbl.icnpblappdashboard.controller.Dashboard"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page title="ICNPB Dashboard">

    <content>

        <!-- KPI Section -->
        <HBox class="sapUiMediumMarginBottom">
        

            <!-- <VBox id="submittedCard" class="kpiCard submittedCard" >
                <Title text="Submitted"/>
                <Text text="{dashboard>/submitted}" class="kpiValue"/>
            </VBox> -->

            <VBox id="allcard" class="kpiCard allCard">
                <Title text="All"/>
                <Text text="{dashboard>/total}" class="kpiValue"/>
            </VBox>

            <VBox  id="approvedCard" class="kpiCard approvedCard">
                <Title text="Approved"/>
                <Text text="{dashboard>/approved}" class="kpiValue"/>
            </VBox>

            <VBox id="rejectedCard" class="kpiCard rejectedCard">
                <Title text="Rejected"/>
                <Text text="{dashboard>/rejected}" class="kpiValue"/>
            </VBox>

            <!-- <VBox id="pendingCard" class="kpiCard pendingCard">
                <Title text="Pending"/>
                <Text text="{dashboard>/draft}" class="kpiValue"/>
            </VBox> -->

            <VBox id="postedCard" class="kpiCard postedCard">
                <Title text="Posted"/>
                <Text text="{dashboard>/posted}" class="kpiValue"/>
            </VBox>

            <VBox id="errorCard" class="kpiCard errorCard">
                <Title text="Error"/>
                <Text text="{dashboard>/error}" class="kpiValue"/>
            </VBox>

            <VBox id="pendingApprovalCard" class="kpiCard pendingApprovalCard">
                <Title text="Pending Approval"/>
                <Text text="{dashboard>/pending_approval}" class="kpiValue"/>
            </VBox>

        
        </HBox>

        <!-- Filter Pills -->
        <!-- <HBox class="sapUiSmallMarginBottom">

            <Button
                text="All"
                type="Emphasized"
                press=".onAllPress"/>

        </HBox> -->

        <!-- Search -->
        <SearchField
            width="100%"
            search=".onSearch"/>

            <!-- <DatePicker
    change=".onDateFilter" /> -->

        <!-- Request Table -->
      <ScrollContainer horizontal="true" vertical="true" width="100%" height="70%">
      
     
        <Table sticky="ColumnHeaders"
            id="requestTable"
            items="{/ICNPBRequest}">

            <columns>

                <Column width="12em">
                    <Text text="Request"/>
                </Column>

                <Column width="10em">
                    <Text text="Billing Type"/>
                </Column>

                <Column width="10em">
                    <Text text="Sub Billing Type"/>
                </Column>

                <Column width="10em">
                    <Text text="Billing Affiliate"/>
                </Column>

                <Column width="10em">
                    <Text text="Receiving Affiliate"/>
                </Column>

                
                <Column width="10em">
                    <Text text="Date"/>
                </Column>

                <Column width="12em">
                    <Text text="Status"/>
                    
                </Column>

                <Column width="15em">
                    <Text text="Approver"/>
                </Column>
                 <Column width="10em">
                    <Text text="Purchase Order"/>
                </Column>
                <Column width="10em">
                    <Text text="Sales Order"/>
                </Column>
                <Column width="10em">
                    <Text text="Voucher Number"/>
                </Column>

                <Column width="10em">
                    <Text text="AR Document"/>
                </Column>

                <Column width="10em">
                    <Text text="AP Document"/>
                </Column>
                <Column width="10em">
                    <Text text="Error Message"/>
                </Column>

                <Column width="15em">
                    <Text text="User"/>
                </Column>

                <Column width="10em">
                    <Text text="Amount"/>
                </Column>

            </columns>

            <items>

                <ColumnListItem>

                    <cells>

                        <Text text="{requestNumber}"/>

                        <Text text="{billingType}"/>

                        <Text text="{billingSubType}"/>

                        <Text text="{billingAffiliateCompanyCode}"/>
                        
                        <Text text="{receivingAffiliateCompanyCode}"/>

                        <Text text="{billAtDate}"/>

                        <ObjectStatus
                            text="{status}"/>
                            <!-- state="{= ${status} === 'APPROVED' ? 'Success' :
                                ${status} === 'DRAFT' ? 'Warning' : 'Information'}"/> -->                      

                        <Text text="{receivingAffiliateContact}"/>
                        <Text text="{purchaseOrderNumber}"/>

                        <Text text="{salesOrderNumber}"/>

                        

                        <Text text="{fiJournalVoucherNumber}"/>

                        <Text text="{ICARDocument}"/>

                        <Text text="{ICAPDocument}"/>
                        <Text text="{errorMessage}"/>
                        <Text text="{userId}"/>

                        <Text text="{= ${totalAmountCustomer} + ' ' + ${currencyCustomer} }" />



                    </cells>

                </ColumnListItem>

            </items>

            <!-- <headerToolbar>
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <ObjectStatus
                        text="Total Items: {view>/totalCount}"
                        state="Information" />
                </OverflowToolbar>
            </headerToolbar> -->

        </Table>
 </ScrollContainer>  
    </content>

</Page>
</mvc:View>

