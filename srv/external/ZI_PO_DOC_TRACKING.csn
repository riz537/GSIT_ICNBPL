{
 "meta": {
  "creator": "cds-dk 9.9.1"
 },
 "$version": "2.0",
 "definitions": {
  "ZI_PO_DOC_TRACKING": {
   "kind": "service",
   "@cds.external": true,
   "@m.IsDefaultEntityContainer": "true",
   "@sap.message.scope.supported": "true",
   "@sap.supported.formats": "atom json xlsx pdf"
  },
  "ZI_PO_DOC_TRACKING.MaterialFIDocFlow": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.content.version": "1",
   "@sap.label": "PO to FI Document via EKBE-BKPF",
   "elements": {
    "PurchaseOrder": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Purchasing Document",
     "@sap.quickinfo": "Purchasing Document Number",
     "notNull": true
    },
    "PurchaseOrderItem": {
     "key": true,
     "type": "cds.String",
     "length": 5,
     "@sap.display.format": "NonNegative",
     "@sap.label": "Item",
     "@sap.quickinfo": "Item Number of Purchasing Document",
     "notNull": true
    },
    "MaterialDocument": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Material Document",
     "@sap.quickinfo": "Number of Material Document",
     "notNull": true
    },
    "MaterialDocumentYear": {
     "key": true,
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "NonNegative",
     "@sap.label": "Material Doc. Year",
     "@sap.quickinfo": "Material Document Year",
     "notNull": true
    },
    "TransactionEvent": {
     "type": "cds.String",
     "length": 1,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Trans./event type",
     "@sap.quickinfo": "Transaction/event type, purchase order history"
    },
    "FIDocument": {
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Document Number",
     "@sap.quickinfo": "Document Number of an Accounting Document"
    },
    "CompanyCode": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Company Code"
    },
    "FIFiscalYear": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "NonNegative",
     "@sap.label": "Fiscal Year"
    },
    "PostingDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Posting Date",
     "@sap.quickinfo": "Posting Date in the Document"
    }
   }
  },
  "ZI_PO_DOC_TRACKING.PurchaseOrderDocTracking": {
   "kind": "entity",
   "@cds.external": true,
   "@cds.persistence.skip": true,
   "@sap.creatable": "false",
   "@sap.updatable": "false",
   "@sap.deletable": "false",
   "@sap.content.version": "1",
   "@sap.label": "PO Document Tracking Root",
   "elements": {
    "PurchaseOrder": {
     "key": true,
     "type": "cds.String",
     "length": 10,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Purchasing Document",
     "@sap.quickinfo": "Purchasing Document Number",
     "notNull": true
    },
    "CompanyCode": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Company Code"
    },
    "PurchaseOrderType": {
     "type": "cds.String",
     "length": 4,
     "@sap.display.format": "UpperCase",
     "@sap.label": "Purchasing Doc. Type",
     "@sap.quickinfo": "Purchasing Document Type"
    },
    "CreationDate": {
     "type": "cds.Date",
     "@sap.display.format": "Date",
     "@sap.label": "Created On",
     "@sap.quickinfo": "Creation Date of Purchasing Document"
    },
    "to_FIFlow": {
     "type": "cds.Association",
     "target": "ZI_PO_DOC_TRACKING.MaterialFIDocFlow",
     "cardinality": {
      "max": "*"
     },
     "keys": []
    },
    "to_SDFlow": {
     "type": "cds.Association",
     "target": "ZI_PO_DOC_TRACKING.SalesDebitMemoFlow",
     "keys": []
    }
   }
  },
